{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "efootwear-api",
    "Audience": "efootwear"
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "LoginRateLimitPerMinute": 20,
    "TrustForwardedHeaders": false
  }
}
